{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-secrets.invalid/schema/structured-extraction-v1.json",
  "title": "Uncanonicalised structured semantic extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objects", "attributes", "counts", "actions", "relations", "scenes", "warnings"],
  "properties": {
    "schema_version": {"const": "structured-extraction-v1"},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "name", "value", "confidence"],
        "properties": {
          "subject": {"type": "string"},
          "name": {"type": "string"},
          "value": {"type": "string"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "value", "confidence"],
        "properties": {
          "object_id": {"type": "string"},
          "value": {"type": "integer", "minimum": 1},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "verb", "object", "confidence"],
        "properties": {
          "subject": {"type": "string"},
          "verb": {"type": "string"},
          "object": {"type": ["string", "null"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "object", "confidence"],
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence"],
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
