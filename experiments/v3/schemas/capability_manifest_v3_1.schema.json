{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-manifest-v3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "created_at_utc", "images"],
  "properties": {
    "schema_version": {"const": "capability-manifest-v3.1.0"},
    "dataset_version": {"const": "p9-v3-capability-data-v3.0.0"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "images": {
      "type": "array", "minItems": 240, "maxItems": 240,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["image_id", "family_id", "stratum", "split", "source_type", "licence", "generator_or_asset_revision", "prompt_hash_if_applicable", "seed_if_applicable", "relative_path", "image_sha256", "annotation_version"],
        "properties": {
          "image_id": {"type": "string", "pattern": "^cap-v3-"},
          "family_id": {"type": "string", "pattern": "^F(0[1-9]|1[0-9]|2[0-4])$"},
          "stratum": {"enum": ["A_controlled_geometric", "B_naturalistic_t2i"]},
          "split": {"enum": ["development", "validation"]},
          "source_type": {"type": "string", "minLength": 1},
          "licence": {"type": "string", "minLength": 1},
          "generator_or_asset_revision": {"type": "string", "minLength": 1},
          "prompt_hash_if_applicable": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "seed_if_applicable": {"type": ["integer", "null"]},
          "relative_path": {"type": "string", "minLength": 1},
          "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "annotation_version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
