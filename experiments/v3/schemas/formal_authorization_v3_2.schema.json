{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal-authorization-v3.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "expected_git_commit", "expected_container_image_digest", "expected_config_hashes", "expected_manifest_sha256", "expected_opportunities_sha256", "expected_ground_truth_freeze_sha256", "expected_threshold_freeze_sha256", "expected_model_manifest_sha256", "pipeline_ids", "authorized_by", "authorized_at_utc"],
  "properties": {
    "schema_version": {"const": "formal-authorization-v3.2.0"},
    "scope": {"const": "P9-v3B-formal-execution"},
    "expected_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_config_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "expected_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_opportunities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_ground_truth_freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_threshold_freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pipeline_ids": {"const": ["v3.1-gdino-siglip2", "v3.1-egtr-siglip2"]},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at_utc": {"type": "string", "format": "date-time"}
  }
}
