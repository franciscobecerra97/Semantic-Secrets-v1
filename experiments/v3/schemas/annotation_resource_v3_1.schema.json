{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation-resource-v3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "annotator_roles", "availability_confirmation", "rubric_version", "independence_statement", "randomized_image_id_procedure", "conflict_provenance_statement", "adjudication_procedure", "confirmed_by", "confirmed_at_utc"],
  "properties": {
    "schema_version": {"const": "annotation-resource-v3.1.0"},
    "status": {"const": "confirmed"},
    "annotator_roles": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["project_researcher", "qualified_independent_external_human"]}},
    "availability_confirmation": {"type": "string", "minLength": 20},
    "rubric_version": {"type": "string", "minLength": 1},
    "independence_statement": {"type": "string", "minLength": 20},
    "randomized_image_id_procedure": {"type": "string", "minLength": 20},
    "conflict_provenance_statement": {"type": "string", "minLength": 20},
    "adjudication_procedure": {"type": "string", "minLength": 20},
    "confirmed_by": {"type": "string", "minLength": 1},
    "confirmed_at_utc": {"type": "string", "format": "date-time"}
  }
}
