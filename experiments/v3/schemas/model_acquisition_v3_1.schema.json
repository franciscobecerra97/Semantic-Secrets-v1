{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-acquisition-v3.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {"const": "model-acquisition-v3.1.0"},
    "components": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["component_id", "revision", "license", "files", "source", "verified"],
        "properties": {
          "component_id": {"enum": ["grounding-dino-tiny", "siglip2-base-384", "egtr-vg"]},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "verified": {"const": true},
          "files": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["relative_path", "bytes", "sha256"],
              "properties": {
                "relative_path": {"type": "string", "minLength": 1},
                "bytes": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
