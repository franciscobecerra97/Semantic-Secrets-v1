{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-secrets.invalid/schema/label-manifest-v1.json",
  "title": "Controlled ground-truth label row",
  "type": "object",
  "additionalProperties": false,
  "required": ["row_id", "family_id", "concept_id", "base_concept_id", "split", "trial_role", "relationship_to_base", "complexity_level", "frequency_band", "expected_atoms", "changed_atom_type", "source_id", "catalog_version", "ontology_version"],
  "properties": {
    "row_id": {"type": "string", "pattern": "^r_[0-9a-f]{24}$"},
    "family_id": {"type": "string", "pattern": "^f[0-9]{3}$"},
    "concept_id": {"type": "string", "pattern": "^c[0-9]{3}[a-z]$"},
    "base_concept_id": {"type": "string", "pattern": "^c[0-9]{3}[a-z]$"},
    "split": {"enum": ["train", "validation", "test"]},
    "trial_role": {"enum": ["enrolment", "seed", "paraphrase", "style", "layout", "model", "near_negative"]},
    "relationship_to_base": {"enum": ["same", "near_negative"]},
    "complexity_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "frequency_band": {"enum": ["common_candidate", "mid_candidate", "rare_candidate"]},
    "expected_atoms": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "changed_atom_type": {"type": ["string", "null"]},
    "source_id": {"const": "controlled_v1"},
    "catalog_version": {"type": "string"},
    "ontology_version": {"const": "controlled-ontology-v1"}
  }
}
